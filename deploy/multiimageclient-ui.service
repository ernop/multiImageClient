# Hardened unit for a colocated shared server. The deploy procedure publishes
# the app read-only under /opt, keeps secrets under /etc, and grants writes
# only to /var/lib/multiimageclient.
[Unit]
Description=MultiImageClient shared web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=multiimageclient
Group=multiimageclient
WorkingDirectory=/opt/multiimageclient
Environment=DOTNET_ROOT=/home/tparkour/.dotnet
Environment=MULTIIMAGECLIENT_SETTINGS=/etc/multiimageclient/settings.json
ExecStart=/home/tparkour/.dotnet/dotnet /opt/multiimageclient/MultiImageClient.dll --ui --ui-port 5960 --ui-no-open
Restart=on-failure
RestartSec=5
UMask=0077

# Be a polite neighbor on a 4 GiB server. The app also limits itself to one
# job / two generators in the production settings and reserves disk space.
Nice=10
CPUQuota=150%
IOWeight=25
MemoryHigh=1200M
MemoryMax=1600M
OOMScoreAdjust=500
TasksMax=256

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/multiimageclient
ReadWritePaths=/var/lib/multiimageclient

[Install]
WantedBy=multi-user.target
